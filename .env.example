# Modèle : copie ce fichier en ".env" et remplace les valeurs par celles de ton application
# sur https://francetravail.io (API « Marché du travail v1 » ajoutée à l'application).
# Le vrai fichier .env est ignoré par git : ne le publie jamais.
FT_CLIENT_ID=PAR_nom_de_ton_application_xxxxxxxx
FT_CLIENT_SECRET=remplace_par_ta_cle_secrete
